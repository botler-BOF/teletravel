---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  author?: string;
  datePublished?: string;
  dateModified?: string;
  image?: string;
  keywords?: string;
  faq?: Array<{ question: string; answer: string }>;
}

const {
  title,
  description,
  author,
  datePublished,
  dateModified,
  image,
  keywords,
  faq,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const isArticle = !!datePublished;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = image ? new URL(`${base}${image}`, Astro.site) : undefined;

const articleSchema = isArticle ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "author": {
    "@type": "Person",
    "name": author,
  },
  "datePublished": datePublished,
  "dateModified": dateModified || datePublished,
  "image": imageURL?.href,
  "publisher": {
    "@type": "Organization",
    "name": "MyTeletravel",
    "url": "https://myteletravel.com",
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL.href,
  },
}) : null;

const faqSchema = faq && faq.length > 0 ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer,
    },
  })),
}) : null;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {author && <meta name="author" content={author} />}
  {keywords && <meta name="keywords" content={keywords} />}
  <link rel="canonical" href={canonicalURL.href} />

  <link rel="icon" type="image/png" href="https://myteletravel.com/images/logo.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={isArticle ? "article" : "website"} />
  <meta property="og:url" content={canonicalURL.href} />
  {imageURL && <meta property="og:image" content={imageURL.href} />}
  <meta name="twitter:card" content="summary_large_image" />

  {articleSchema && <script type="application/ld+json" set:html={articleSchema} />}
  {faqSchema && <script type="application/ld+json" set:html={faqSchema} />}
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>

<style is:global>
  :root {
    --brand-orange: #ff7e33;
    --brand-orange-dark: #e66a1f;
    --brand-blue-light: #5ae2e1;
    --brand-blue-marine: #008796;
    --background: #ffffff;
    --foreground: #1a1a1a;
    --muted: #f5f5f5;
    --muted-foreground: #666666;
    --border: #000000;
    --card: #ffffff;
    --primary: var(--brand-orange);
    --accent: var(--brand-blue-marine);
    --secondary: var(--brand-blue-light);
    --radius: 0;
    --font-sans: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-sans);
    line-height: 1.6;
    color: var(--foreground);
    background: var(--background);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  main {
    min-height: 60vh;
  }

  h1, h2, h3, h4 {
    font-family: var(--font-sans);
    color: var(--foreground);
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 700;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-bottom: 1.25rem;
  }

  h2 {
    font-size: clamp(1.4rem, 2.5vw, 1.75rem);
    font-weight: 600;
    margin-top: 3rem;
    margin-bottom: 1rem;
  }

  h3 {
    font-size: 1.15rem;
    font-weight: 600;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }

  p {
    margin-bottom: 1.2rem;
    color: var(--foreground);
    font-size: 1rem;
  }

  a {
    color: var(--brand-orange);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  a:hover {
    color: var(--brand-orange-dark);
    text-decoration: underline;
  }

  img {
    max-width: 100%;
    height: auto;
    border-radius: 0;
  }

  ul, ol {
    margin: 0 0 1.2rem 1.4rem;
    color: var(--foreground);
  }

  li {
    margin-bottom: 0.4rem;
  }

  blockquote {
    border-left: 4px solid var(--brand-orange);
    padding: 0.5rem 0 0.5rem 1.25rem;
    margin: 1.5rem 0;
    color: var(--muted-foreground);
    font-style: italic;
  }

  /* Mono labels (eyebrows, tags, dates) */
  .mono {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.78rem;
    font-weight: 700;
  }

  /* Markdown-rendered FAQ section */
  #faq {
    background: var(--muted);
    border: 2px solid var(--border);
    padding: 2rem 2.25rem;
    border-radius: 0;
    margin-top: 4rem;
  }

  #faq h2 {
    margin-top: 0;
    margin-bottom: 1.5rem;
    color: var(--foreground);
    font-size: 1.6rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  #faq h3 {
    color: var(--foreground);
    font-weight: 700;
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
    margin-top: 1.25rem;
    font-size: 1.05rem;
  }

  #faq h3:first-of-type {
    border-top: none;
    padding-top: 0;
    margin-top: 0;
  }

  #faq p {
    color: #2a2a2a;
  }
</style>
