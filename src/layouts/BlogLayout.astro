---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  author?: string;
  datePublished?: string;
  dateModified?: string;
  image?: string;
  keywords?: string;
  faq?: Array<{ question: string; answer: string }>;
}

const {
  title,
  description,
  author,
  datePublished,
  dateModified,
  image,
  keywords,
  faq,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const isArticle = !!datePublished;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = image ? new URL(`${base}${image}`, Astro.site) : undefined;

const articleSchema = isArticle ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "author": {
    "@type": "Person",
    "name": author,
  },
  "datePublished": datePublished,
  "dateModified": dateModified || datePublished,
  "image": imageURL?.href,
  "publisher": {
    "@type": "Organization",
    "name": "MyTeletravel",
    "url": "https://myteletravel.com",
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL.href,
  },
}) : null;

const faqSchema = faq && faq.length > 0 ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer,
    },
  })),
}) : null;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {author && <meta name="author" content={author} />}
  {keywords && <meta name="keywords" content={keywords} />}
  <link rel="canonical" href={canonicalURL.href} />

  <link rel="icon" type="image/png" href="https://myteletravel.com/images/logo.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={isArticle ? "article" : "website"} />
  <meta property="og:url" content={canonicalURL.href} />
  {imageURL && <meta property="og:image" content={imageURL.href} />}
  <meta name="twitter:card" content="summary_large_image" />

  {articleSchema && <script type="application/ld+json" set:html={articleSchema} />}
  {faqSchema && <script type="application/ld+json" set:html={faqSchema} />}
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>

<style is:global>
  :root {
    --orange: #ff7e33;
    --orange-dark: #e66a1f;
    --orange-soft: #fff1e6;
    --teal: #008796;
    --teal-soft: #e6f4f6;
    --cyan: #5ae2e1;
    --cyan-soft: #ecfbfb;
    --ink: #1a1a1a;
    --ink-soft: #2a2a2a;
    --muted: #6b6b6b;
    --muted-2: #9a9a9a;
    --bg: #ffffff;
    --bg-soft: #fafafa;
    --bg-card: #ffffff;
    --border: #ececec;
    --border-strong: #1a1a1a;
    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.04), 0 2px 4px rgba(0, 0, 0, 0.04);
    --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.06), 0 12px 28px rgba(0, 0, 0, 0.08);
    --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.08), 0 24px 56px rgba(0, 0, 0, 0.12);
    --shadow-orange: 0 12px 32px rgba(255, 126, 51, 0.28);
    --radius-sm: 8px;
    --radius-md: 14px;
    --radius-lg: 22px;
    --radius-pill: 999px;
    --font: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --ease: cubic-bezier(0.4, 0, 0.2, 1);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font);
    line-height: 1.65;
    color: var(--ink);
    background: var(--bg);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  main {
    min-height: 60vh;
  }

  h1, h2, h3, h4 {
    font-family: var(--font);
    color: var(--ink);
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  h2 {
    font-size: clamp(1.5rem, 2.6vw, 1.85rem);
    font-weight: 700;
    line-height: 1.25;
    margin-top: 3rem;
    margin-bottom: 1.1rem;
  }

  h3 {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.4;
    margin-top: 1.85rem;
    margin-bottom: 0.5rem;
  }

  p {
    margin-bottom: 1.2rem;
    color: var(--ink-soft);
    font-size: 1.02rem;
  }

  a {
    color: var(--orange);
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }

  a:hover {
    color: var(--orange-dark);
  }

  img {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }

  ul, ol {
    margin: 0 0 1.4rem 1.4rem;
    color: var(--ink-soft);
  }

  li {
    margin-bottom: 0.45rem;
  }

  blockquote {
    border-left: 4px solid var(--orange);
    padding: 0.75rem 0 0.75rem 1.5rem;
    margin: 2rem 0;
    color: var(--muted);
    font-style: italic;
    font-size: 1.08rem;
  }

  /* Markdown-rendered FAQ section */
  #faq {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    padding: 2.25rem 2.5rem;
    border-radius: var(--radius-lg);
    margin-top: 4rem;
    box-shadow: var(--shadow-sm);
  }

  #faq h2 {
    margin-top: 0;
    margin-bottom: 1.75rem;
    color: var(--ink);
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  #faq h3 {
    color: var(--ink);
    font-weight: 600;
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
    margin-top: 1.5rem;
    font-size: 1.05rem;
  }

  #faq h3:first-of-type {
    border-top: none;
    padding-top: 0;
    margin-top: 0;
  }

  #faq p {
    color: var(--muted);
    line-height: 1.7;
  }

  /* Reusable button styles for content links */
  .btn-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--orange);
    color: #fff;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius-pill);
    border: none;
    cursor: pointer;
    transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease), background 0.2s var(--ease);
    box-shadow: var(--shadow-orange);
    text-decoration: none;
  }

  .btn-pill:hover {
    background: var(--orange-dark);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 16px 36px rgba(255, 126, 51, 0.38);
    text-decoration: none;
  }

  .btn-pill-outline {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    color: var(--ink);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--ink);
    cursor: pointer;
    transition: all 0.2s var(--ease);
    text-decoration: none;
  }

  .btn-pill-outline:hover {
    background: var(--ink);
    color: #fff;
    text-decoration: none;
  }
</style>
