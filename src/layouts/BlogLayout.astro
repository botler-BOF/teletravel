---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  author?: string;
  datePublished?: string;
  dateModified?: string;
  image?: string;
  keywords?: string;
  faq?: Array<{ question: string; answer: string }>;
}

const {
  title,
  description,
  author,
  datePublished,
  dateModified,
  image,
  keywords,
  faq,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const isArticle = !!datePublished;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = image ? new URL(`${base}${image}`, Astro.site) : undefined;

const articleSchema = isArticle ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "author": {
    "@type": "Person",
    "name": author,
  },
  "datePublished": datePublished,
  "dateModified": dateModified || datePublished,
  "image": imageURL?.href,
  "publisher": {
    "@type": "Organization",
    "name": "MyTeletravel",
    "url": "https://myteletravel.com",
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL.href,
  },
}) : null;

const faqSchema = faq && faq.length > 0 ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer,
    },
  })),
}) : null;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {author && <meta name="author" content={author} />}
  {keywords && <meta name="keywords" content={keywords} />}
  <link rel="canonical" href={canonicalURL.href} />

  <link rel="icon" type="image/png" href="https://myteletravel.com/images/logo.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet" />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={isArticle ? "article" : "website"} />
  <meta property="og:url" content={canonicalURL.href} />
  {imageURL && <meta property="og:image" content={imageURL.href} />}
  <meta name="twitter:card" content="summary_large_image" />

  {articleSchema && <script type="application/ld+json" set:html={articleSchema} />}
  {faqSchema && <script type="application/ld+json" set:html={faqSchema} />}
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>

<style is:global>
  :root {
    --color-bg: #ffffff;
    --color-bg-soft: #f8f8f7;
    --color-text: #1a1a19;
    --color-text-soft: #4a4a48;
    --color-muted: #858481;
    --color-border: #e5e5e5;
    --color-dark: #000000;
    --color-accent: #ff7e33;
    --color-accent-hover: #e66a1f;
    --color-teal: #008796;
    --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-display: 'Poppins', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-body);
    line-height: 1.7;
    color: var(--color-text);
    background: var(--color-bg);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  main {
    min-height: 60vh;
  }

  h1, h2, h3, h4 {
    font-family: var(--font-display);
    color: var(--color-text);
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    margin-bottom: 1.25rem;
    color: var(--color-dark);
  }

  h2 {
    font-size: clamp(1.4rem, 2.5vw, 1.75rem);
    font-weight: 600;
    margin-top: 3rem;
    margin-bottom: 1rem;
  }

  h3 {
    font-size: 1.15rem;
    font-weight: 600;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }

  p {
    margin-bottom: 1.2rem;
    color: var(--color-text-soft);
    font-size: 1.02rem;
  }

  a {
    color: var(--color-accent);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  a:hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }

  img {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
  }

  ul, ol {
    margin: 0 0 1.2rem 1.4rem;
    color: var(--color-text-soft);
  }

  li {
    margin-bottom: 0.4rem;
  }

  blockquote {
    border-left: 3px solid var(--color-accent);
    padding: 0.5rem 0 0.5rem 1.25rem;
    margin: 1.5rem 0;
    color: var(--color-text-soft);
    font-style: italic;
  }

  #faq {
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    padding: 2rem 2.25rem;
    border-radius: 16px;
    margin-top: 3.5rem;
  }

  #faq h2 {
    margin-top: 0;
    color: var(--color-dark);
  }

  #faq h3 {
    color: var(--color-dark);
    font-family: var(--font-display);
    font-weight: 600;
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
    margin-top: 1.5rem;
  }

  #faq h3:first-of-type {
    border-top: none;
    padding-top: 0;
    margin-top: 1rem;
  }
</style>
