---
import BlogLayout from '../layouts/BlogLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('blog');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BlogLayout
  title={article.data.title}
  description={article.data.description}
  author={article.data.author}
  datePublished={article.data.datePublished}
  dateModified={article.data.dateModified}
  image={article.data.image}
  keywords={article.data.keywords}
  faq={article.data.faq}
>
  <article class="article">
    <header class="article-header">
      <a href={`${base}/`} class="back-link">← All articles</a>
      <h1>{article.data.title}</h1>
      <p class="article-lead">{article.data.description}</p>
      <div class="article-meta">
        <div class="author-block">
          <span class="author-avatar">{article.data.author.charAt(0)}</span>
          <div>
            <p class="author-name">{article.data.author}</p>
            <time class="article-date" datetime={article.data.datePublished}>
              {new Date(article.data.datePublished).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
          </div>
        </div>
      </div>
    </header>

    {article.data.image && (
      <img
        class="hero-image"
        src={`${base}${article.data.image}`}
        alt={article.data.imageAlt || article.data.title}
        loading="eager"
      />
    )}

    <div class="article-body">
      <Content />
    </div>
  </article>
</BlogLayout>

<style>
  .article {
    max-width: 760px;
    margin: 0 auto;
    padding: 3rem 1.5rem 2rem;
  }

  .article-header {
    margin-bottom: 2.5rem;
  }

  .back-link {
    display: inline-block;
    color: #858481;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 1.75rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: #ff7e33;
    text-decoration: none;
  }

  .article-header h1 {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: #000000;
    margin-bottom: 1rem;
  }

  .article-lead {
    font-size: 1.15rem;
    color: #4a4a48;
    line-height: 1.55;
    margin-bottom: 2rem;
  }

  .article-meta {
    border-top: 1px solid #e5e5e5;
    border-bottom: 1px solid #e5e5e5;
    padding: 1.25rem 0;
  }

  .author-block {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .author-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, #ff7e33 0%, #ff5252 100%);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 1.05rem;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .author-name {
    font-weight: 600;
    color: #1a1a19;
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.2;
  }

  .article-date {
    font-size: 0.85rem;
    color: #858481;
  }

  .hero-image {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
    border-radius: 16px;
    margin-bottom: 2.5rem;
  }

  .article-body :global(h2) {
    font-family: 'Poppins', sans-serif;
    font-size: 1.6rem;
    font-weight: 600;
    color: #000000;
    margin-top: 3rem;
    margin-bottom: 1rem;
    letter-spacing: -0.015em;
  }

  .article-body :global(p) {
    font-size: 1.05rem;
    line-height: 1.75;
    color: #2a2a2a;
    margin-bottom: 1.4rem;
  }

  .article-body :global(img) {
    width: 100%;
    border-radius: 12px;
    margin: 2rem 0;
  }

  .article-body :global(a) {
    color: #ff7e33;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .article-body :global(a:hover) {
    color: #e66a1f;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 1.4rem 1.5rem;
    color: #2a2a2a;
    font-size: 1.05rem;
  }

  .article-body :global(li) {
    margin-bottom: 0.5rem;
  }

  .article-body :global(strong) {
    color: #000000;
    font-weight: 600;
  }

  @media (max-width: 600px) {
    .article {
      padding: 2rem 1.25rem 1.5rem;
    }
  }
</style>
