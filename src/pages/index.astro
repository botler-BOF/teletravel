---
import BlogLayout from '../layouts/BlogLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.datePublished).getTime() - new Date(a.data.datePublished).getTime()
);

const featured = articles[0];
const rest = articles.slice(1);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BlogLayout
  title="MyTeletravel Blog — Travel guides, destinations & remote work tips"
  description="Travel guides, destination tips and remote work advice from the MyTeletravel team. Discover where to stay, work, and explore around the world."
>
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow"><span class="dot-orange">●</span> The MyTeletravel Blog</p>
      <h1>
        Travel guides for <span class="hl">remote workers</span><br />
        &amp; curious explorers.
      </h1>
      <p class="hero-sub">
        Destination deep-dives, practical tips and stories from the road —
        curated by the MyTeletravel team to help you stay, work and explore
        anywhere in the world.
      </p>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-num">{articles.length}</span>
          <span class="stat-label">Articles</span>
        </div>
        <div class="stat">
          <span class="stat-num">∞</span>
          <span class="stat-label">Destinations</span>
        </div>
        <div class="stat">
          <span class="stat-num">100%</span>
          <span class="stat-label">Curated</span>
        </div>
      </div>
    </div>
  </section>

  <section class="content">
    {articles.length === 0 ? (
      <div class="empty">
        <p>No articles published yet. Check back soon.</p>
      </div>
    ) : (
      <>
        {featured && (
          <a href={`${base}/${featured.id}/`} class="featured">
            {featured.data.image && (
              <div class="featured-image">
                <img
                  src={`${base}${featured.data.image}`}
                  alt={featured.data.imageAlt || featured.data.title}
                  loading="eager"
                />
              </div>
            )}
            <div class="featured-body">
              <p class="featured-tag">Latest article</p>
              <h2>{featured.data.title}</h2>
              <p class="featured-desc">{featured.data.description}</p>
              <p class="featured-meta">
                <span class="author">{featured.data.author}</span>
                <span class="sep">/</span>
                <time datetime={featured.data.datePublished}>
                  {new Date(featured.data.datePublished).toLocaleDateString('en-US', {
                    year: 'numeric', month: 'long', day: 'numeric',
                  })}
                </time>
              </p>
              <span class="featured-cta">Read article →</span>
            </div>
          </a>
        )}

        {rest.length > 0 && (
          <>
            <div class="grid-header">
              <h2 class="grid-title">More articles</h2>
              <p class="grid-count">{rest.length} {rest.length === 1 ? 'story' : 'stories'}</p>
            </div>
            <div class="articles-grid">
              {rest.map((article) => (
                <ArticleCard
                  title={article.data.title}
                  description={article.data.description}
                  slug={article.id}
                  datePublished={article.data.datePublished}
                  author={article.data.author}
                  image={article.data.image}
                />
              ))}
            </div>
          </>
        )}
      </>
    )}
  </section>
</BlogLayout>

<style>
  .hero {
    background: #ffffff;
    color: #1a1a1a;
    padding: 5rem 1.5rem 4.5rem;
    border-bottom: 2px solid #000000;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 60px;
    right: -120px;
    width: 320px;
    height: 320px;
    background: #5ae2e1;
    opacity: 0.6;
    z-index: 0;
    transform: rotate(15deg);
  }

  .hero::after {
    content: '';
    position: absolute;
    bottom: -100px;
    left: -80px;
    width: 240px;
    height: 240px;
    background: #ff7e33;
    opacity: 0.18;
    z-index: 0;
    border-radius: 50%;
  }

  .hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    font-family: 'JetBrains Mono', monospace;
    color: #1a1a1a;
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin: 0 0 1.5rem;
  }

  .dot-orange {
    color: #ff7e33;
    margin-right: 0.4rem;
  }

  .hero h1 {
    font-family: 'Poppins', sans-serif;
    color: #1a1a1a;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.025em;
    max-width: 18ch;
    margin: 0 0 1.75rem;
  }

  .hl {
    background: #ff7e33;
    color: #ffffff;
    padding: 0 0.4rem;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .hero-sub {
    color: #2a2a2a;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.6;
    max-width: 56ch;
    margin: 0 0 2.25rem;
  }

  .hero-stats {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .stat {
    border: 2px solid #000000;
    background: #ffffff;
    padding: 0.85rem 1.25rem;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    box-shadow: 4px 4px 0 #000000;
  }

  .stat-num {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 1.4rem;
    color: #ff7e33;
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #1a1a1a;
    font-weight: 700;
  }

  .content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1.5rem 2rem;
  }

  .empty {
    text-align: center;
    padding: 4rem 1rem;
    color: #666666;
    border: 2px dashed #000000;
  }

  .featured {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 0;
    background: #ffffff;
    border: 2px solid #000000;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    margin-bottom: 4rem;
    box-shadow: 8px 8px 0 #000000;
  }

  .featured:hover {
    transform: translate(-4px, -4px);
    box-shadow: 12px 12px 0 #ff7e33;
    text-decoration: none;
  }

  .featured-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #f5f5f5;
    border-right: 2px solid #000000;
  }

  .featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    transition: transform 0.5s ease;
  }

  .featured:hover .featured-image img {
    transform: scale(1.04);
  }

  .featured-body {
    padding: 2.5rem 2.5rem 2.5rem 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .featured-tag {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #1a1a1a;
    background: #5ae2e1;
    border: 2px solid #000000;
    padding: 0.3rem 0.65rem;
    margin: 0 0 1.25rem;
    align-self: flex-start;
  }

  .featured h2 {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 1rem;
    color: #1a1a1a;
    letter-spacing: -0.02em;
  }

  .featured-desc {
    font-size: 1rem;
    color: #2a2a2a;
    line-height: 1.6;
    margin: 0 0 1.5rem;
  }

  .featured-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    color: #1a1a1a;
    margin: 0 0 1.5rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .featured-meta .author {
    color: #ff7e33;
  }

  .featured-meta .sep {
    margin: 0 0.5rem;
  }

  .featured-cta {
    color: #1a1a1a;
    font-weight: 700;
    font-size: 0.95rem;
    border-bottom: 2px solid #ff7e33;
    padding-bottom: 1px;
    align-self: flex-start;
  }

  .grid-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: 0 0 1.75rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid #000000;
  }

  .grid-title {
    font-family: 'Poppins', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .grid-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #666666;
    font-weight: 700;
    margin: 0;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.75rem;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 3rem 1.25rem 3rem;
    }
    .featured {
      grid-template-columns: 1fr;
    }
    .featured-image {
      border-right: none;
      border-bottom: 2px solid #000000;
    }
    .featured-body {
      padding: 1.75rem 1.5rem 2rem;
    }
    .content {
      padding: 3rem 1.25rem 2rem;
    }
    .articles-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
