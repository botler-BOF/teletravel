---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<header>
  <div class="header-inner">
    <a href={base} class="logo">
      <span class="logo-mark">My</span>Teletravel
      <span class="logo-tag">Blog</span>
    </a>
    <nav class="nav-links">
      <a href={base}>Articles</a>
      <a href="https://myteletravel.com">Destinations</a>
      <a href="https://myteletravel.com" class="cta">Visit site →</a>
    </nav>
  </div>
</header>

<style>
  header {
    background: #ffffff;
    color: #1a1a1a;
    padding: 1.1rem 1.5rem;
    border-bottom: 2px solid #000000;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .logo {
    font-family: 'Poppins', sans-serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: #1a1a1a;
    text-decoration: none;
    letter-spacing: -0.02em;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .logo:hover {
    color: #1a1a1a;
    text-decoration: none;
  }

  .logo-mark {
    color: #ff7e33;
  }

  .logo-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #1a1a1a;
    background: #5ae2e1;
    border: 2px solid #000000;
    padding: 0.18rem 0.55rem;
    margin-left: 0.4rem;
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .nav-links a {
    color: #1a1a1a;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .nav-links a:hover {
    color: #ff7e33;
    text-decoration: none;
  }

  .nav-links .cta {
    background: #ff7e33;
    color: #ffffff;
    padding: 0.55rem 1.1rem;
    border: 2px solid #000000;
    font-weight: 600;
    box-shadow: 4px 4px 0 #000000;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }

  .nav-links .cta:hover {
    color: #ffffff;
    background: #ff7e33;
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 #000000;
  }

  @media (max-width: 700px) {
    header {
      padding: 0.9rem 1rem;
    }
    .logo {
      font-size: 1.15rem;
    }
    .logo-tag {
      display: none;
    }
    .nav-links {
      gap: 0.9rem;
    }
    .nav-links a:not(.cta) {
      display: none;
    }
    .nav-links .cta {
      box-shadow: 3px 3px 0 #000000;
      padding: 0.45rem 0.9rem;
    }
  }
</style>
