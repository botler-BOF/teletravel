---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<header>
  <div class="header-inner">
    <a href={base} class="logo">
      <span class="logo-mark">My</span>Teletravel
      <span class="logo-tag">Blog</span>
    </a>
    <nav class="nav-links">
      <a href={base}>Articles</a>
      <a href="https://myteletravel.com/destinations">Destinations</a>
      <a href="https://myteletravel.com" class="cta">
        Visit site
        <span class="arrow">→</span>
      </a>
    </nav>
  </div>
</header>

<style>
  header {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    color: #1a1a1a;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #ececec;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .logo {
    font-family: 'Poppins', sans-serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: #1a1a1a;
    text-decoration: none;
    letter-spacing: -0.025em;
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .logo:hover {
    color: #1a1a1a;
    text-decoration: none;
  }

  .logo-mark {
    color: #ff7e33;
  }

  .logo-tag {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #008796;
    background: #ecfbfb;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    margin-left: 0.2rem;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .nav-links a {
    color: #2a2a2a;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.2s ease;
    position: relative;
  }

  .nav-links a:not(.cta):hover {
    color: #ff7e33;
    text-decoration: none;
  }

  .nav-links a:not(.cta)::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: 0;
    height: 2px;
    background: #ff7e33;
    transform: translateX(-50%);
    transition: width 0.25s ease;
    border-radius: 2px;
  }

  .nav-links a:not(.cta):hover::after {
    width: 100%;
  }

  .nav-links .cta {
    background: #1a1a1a;
    color: #ffffff;
    padding: 0.6rem 1.25rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.92rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .nav-links .cta:hover {
    background: #ff7e33;
    color: #ffffff;
    text-decoration: none;
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(255, 126, 51, 0.32);
  }

  .nav-links .cta .arrow {
    transition: transform 0.25s ease;
    display: inline-block;
  }

  .nav-links .cta:hover .arrow {
    transform: translateX(3px);
  }

  @media (max-width: 700px) {
    header {
      padding: 0.85rem 1rem;
    }
    .logo {
      font-size: 1.15rem;
    }
    .logo-tag {
      display: none;
    }
    .nav-links {
      gap: 1rem;
    }
    .nav-links a:not(.cta) {
      display: none;
    }
    .nav-links .cta {
      padding: 0.55rem 1rem;
      font-size: 0.88rem;
    }
  }
</style>
