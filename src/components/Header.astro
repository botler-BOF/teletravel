---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<header>
  <div class="header-inner">
    <a href={base} class="logo">
      <span class="logo-mark">My</span><span class="logo-text">Teletravel</span>
      <span class="logo-tag">Blog</span>
    </a>
    <nav class="nav-links">
      <a href={base}>Articles</a>
      <a href="https://myteletravel.com" class="cta">Visit site →</a>
    </nav>
  </div>
</header>

<style>
  header {
    background: #000000;
    color: #ffffff;
    padding: 1.1rem 1.5rem;
    border-bottom: 1px solid #1a1a19;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .logo {
    font-family: 'Poppins', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    text-decoration: none;
    letter-spacing: -0.02em;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .logo:hover {
    color: #ffffff;
    text-decoration: none;
  }

  .logo-mark {
    color: #ff7e33;
  }

  .logo-text {
    color: #ffffff;
  }

  .logo-tag {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #5ae2e1;
    border: 1px solid #5ae2e1;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    margin-left: 0.25rem;
  }

  .nav-links {
    display: flex;
    gap: 1.75rem;
    align-items: center;
  }

  .nav-links a {
    color: #d4d4d4;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .nav-links a:hover {
    color: #ffffff;
    text-decoration: none;
  }

  .nav-links .cta {
    background: #ff7e33;
    color: #000000;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    font-weight: 600;
  }

  .nav-links .cta:hover {
    background: #ffffff;
    color: #000000;
  }

  @media (max-width: 600px) {
    header {
      padding: 0.9rem 1rem;
    }
    .logo {
      font-size: 1.15rem;
    }
    .logo-tag {
      display: none;
    }
    .nav-links {
      gap: 0.9rem;
    }
    .nav-links a:not(.cta) {
      display: none;
    }
  }
</style>
