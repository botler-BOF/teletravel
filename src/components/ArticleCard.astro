---
interface Props {
  title: string;
  description: string;
  slug: string;
  datePublished: string;
  author: string;
  image?: string;
}

const { title, description, slug, datePublished, author, image } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/${slug}/`;

const formattedDate = new Date(datePublished).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="card">
  <a href={href}>
    {image && (
      <div class="card-image">
        <img src={`${base}${image}`} alt={title} loading="lazy" />
      </div>
    )}
    <div class="card-body">
      <p class="meta">
        <span class="author">{author}</span>
        <span class="dot">•</span>
        <time datetime={datePublished}>{formattedDate}</time>
      </p>
      <h2>{title}</h2>
      <p class="desc">{description}</p>
      <span class="read-more">
        Read article
        <span class="arrow">→</span>
      </span>
    </div>
  </a>
</article>

<style>
  .card {
    background: #ffffff;
    border: 1px solid #ececec;
    border-radius: 22px;
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                border-color 0.3s ease;
    height: 100%;
    display: flex;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 2px 4px rgba(0, 0, 0, 0.04);
  }

  .card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08), 0 24px 48px rgba(0, 0, 0, 0.06);
    border-color: transparent;
  }

  .card a {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .card a:hover {
    text-decoration: none;
  }

  .card-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #f5f5f5;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .card:hover .card-image img {
    transform: scale(1.06);
  }

  .card-body {
    padding: 1.6rem 1.6rem 1.85rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  h2 {
    font-family: 'Poppins', sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 0.7rem;
    color: #1a1a1a;
    letter-spacing: -0.02em;
  }

  .meta {
    font-size: 0.82rem;
    color: #6b6b6b;
    margin: 0 0 0.85rem;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .meta .author {
    color: #1a1a1a;
    font-weight: 600;
  }

  .meta .dot {
    color: #d4d4d4;
  }

  .desc {
    font-size: 0.95rem;
    color: #6b6b6b;
    margin: 0 0 1.25rem;
    line-height: 1.6;
    flex-grow: 1;
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: #ff7e33;
    margin-top: auto;
  }

  .read-more .arrow {
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    display: inline-block;
  }

  .card:hover .read-more .arrow {
    transform: translateX(4px);
  }
</style>
