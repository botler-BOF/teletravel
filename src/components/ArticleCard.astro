---
interface Props {
  title: string;
  description: string;
  slug: string;
  datePublished: string;
  author: string;
  image?: string;
}

const { title, description, slug, datePublished, author, image } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/${slug}/`;

const formattedDate = new Date(datePublished).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="card">
  <a href={href}>
    {image && (
      <div class="card-image">
        <img src={`${base}${image}`} alt={title} loading="lazy" />
      </div>
    )}
    <div class="card-body">
      <p class="meta">
        <span class="author">{author}</span>
        <span class="dot">/</span>
        <time datetime={datePublished}>{formattedDate}</time>
      </p>
      <h2>{title}</h2>
      <p class="desc">{description}</p>
      <span class="read-more">Read article →</span>
    </div>
  </a>
</article>

<style>
  .card {
    background: #ffffff;
    border: 2px solid #000000;
    overflow: hidden;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    height: 100%;
    display: flex;
    box-shadow: 6px 6px 0 #000000;
  }

  .card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0 #ff7e33;
  }

  .card a {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .card a:hover {
    text-decoration: none;
  }

  .card-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #f5f5f5;
    border-bottom: 2px solid #000000;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    transition: transform 0.4s ease;
  }

  .card:hover .card-image img {
    transform: scale(1.05);
  }

  .card-body {
    padding: 1.5rem 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  h2 {
    font-family: 'Poppins', sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 0.65rem;
    color: #1a1a1a;
    letter-spacing: -0.015em;
  }

  .meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: #1a1a1a;
    margin: 0 0 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
  }

  .meta .author {
    color: #ff7e33;
  }

  .meta .dot {
    margin: 0 0.4rem;
    color: #1a1a1a;
  }

  .desc {
    font-size: 0.95rem;
    color: #2a2a2a;
    margin: 0 0 1.1rem;
    line-height: 1.55;
    flex-grow: 1;
  }

  .read-more {
    font-family: 'Poppins', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    color: #1a1a1a;
    margin-top: auto;
    border-bottom: 2px solid #ff7e33;
    align-self: flex-start;
    padding-bottom: 1px;
  }

  .card:hover .read-more {
    color: #ff7e33;
  }
</style>
