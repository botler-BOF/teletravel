---
interface Props {
  items: Array<{ question: string; answer: string }>;
}

const { items } = Astro.props;
---

<section id="faq">
  <h2>Frequently asked questions</h2>
  {items.map((item) => (
    <div class="faq-item">
      <h3>{item.question}</h3>
      <p>{item.answer}</p>
    </div>
  ))}
</section>

<style>
  #faq {
    background: #fafafa;
    border: 1px solid #ececec;
    padding: 2.5rem 2.75rem 2rem;
    border-radius: 22px;
    margin-top: 4rem;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }

  h2 {
    font-family: 'Poppins', sans-serif;
    margin: 0 0 1.75rem;
    color: #1a1a1a;
    font-size: 1.7rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .faq-item {
    border-top: 1px solid #ececec;
    padding: 1.5rem 0;
  }

  .faq-item:first-of-type {
    border-top: none;
    padding-top: 0;
  }

  .faq-item:last-of-type {
    padding-bottom: 0;
  }

  h3 {
    font-family: 'Poppins', sans-serif;
    color: #1a1a1a;
    font-size: 1.08rem;
    font-weight: 600;
    margin-bottom: 0.55rem;
    line-height: 1.4;
  }

  p {
    color: #4a4a4a;
    margin: 0;
    line-height: 1.7;
    font-size: 0.98rem;
  }
</style>
