---
interface Props {
  items: Array<{ question: string; answer: string }>;
}

const { items } = Astro.props;
---

<section id="faq">
  <h2>Frequently asked questions</h2>
  {items.map((item) => (
    <div class="faq-item">
      <h3>{item.question}</h3>
      <p>{item.answer}</p>
    </div>
  ))}
</section>

<style>
  #faq {
    background: #f5f5f5;
    border: 2px solid #000000;
    padding: 2.25rem 2.25rem 1.75rem;
    margin-top: 4rem;
  }

  h2 {
    font-family: 'Poppins', sans-serif;
    margin: 0 0 1.5rem;
    color: #1a1a1a;
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .faq-item {
    border-top: 1px solid #000000;
    padding: 1.25rem 0;
  }

  .faq-item:first-of-type {
    border-top: none;
    padding-top: 0;
  }

  .faq-item:last-of-type {
    padding-bottom: 0;
  }

  h3 {
    font-family: 'Poppins', sans-serif;
    color: #1a1a1a;
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  p {
    color: #2a2a2a;
    margin: 0;
    line-height: 1.65;
  }
</style>
