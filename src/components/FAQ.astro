---
interface Props {
  items: Array<{ question: string; answer: string }>;
}

const { items } = Astro.props;
---

<section id="faq">
  <h2>Frequently asked questions</h2>
  {items.map((item) => (
    <div class="faq-item">
      <h3>{item.question}</h3>
      <p>{item.answer}</p>
    </div>
  ))}
</section>

<style>
  #faq {
    background: #f8f8f7;
    border: 1px solid #e5e5e5;
    padding: 2.25rem 2.25rem 1.75rem;
    border-radius: 16px;
    margin-top: 3.5rem;
  }

  h2 {
    font-family: 'Poppins', sans-serif;
    margin: 0 0 1.5rem;
    color: #000000;
    font-size: 1.5rem;
    font-weight: 600;
  }

  .faq-item {
    border-top: 1px solid #e5e5e5;
    padding: 1.25rem 0;
  }

  .faq-item:first-of-type {
    border-top: none;
    padding-top: 0;
  }

  .faq-item:last-of-type {
    padding-bottom: 0;
  }

  h3 {
    font-family: 'Poppins', sans-serif;
    color: #000000;
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  p {
    color: #4a4a48;
    margin: 0;
    line-height: 1.65;
  }
</style>
