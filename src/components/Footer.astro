---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<footer>
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="https://myteletravel.com" class="footer-logo">
        <span class="brand-mark">My</span>Teletravel
      </a>
      <p class="tagline">Remote work stays around the world.</p>
    </div>
    <div class="footer-cols">
      <div class="footer-col">
        <p class="col-title">Site</p>
        <a href="https://myteletravel.com">Home</a>
        <a href="https://myteletravel.com/destinations">Destinations</a>
        <a href={base}>Blog</a>
        <a href="https://myteletravel.com/contact">Contact</a>
      </div>
      <div class="footer-col">
        <p class="col-title">More</p>
        <a href="https://myteletravel.com">About</a>
        <a href="https://myteletravel.com">FAQ</a>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <p>&copy; {year} MyTeletravel — All rights reserved.</p>
  </div>
</footer>

<style>
  footer {
    background: #ffffff;
    color: #1a1a1a;
    margin-top: 5rem;
    border-top: 2px solid #000000;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem 2rem;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem;
    align-items: flex-start;
  }

  .footer-brand {
    max-width: 360px;
  }

  .footer-logo {
    font-family: 'Poppins', sans-serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: #1a1a1a;
    text-decoration: none;
    letter-spacing: -0.02em;
    display: inline-block;
    margin-bottom: 0.6rem;
  }

  .footer-logo:hover {
    color: #1a1a1a;
    text-decoration: none;
  }

  .brand-mark {
    color: #ff7e33;
  }

  .tagline {
    font-size: 0.9rem;
    color: #666666;
    margin: 0;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .col-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #1a1a1a;
    margin-bottom: 0.4rem;
  }

  .footer-col a {
    color: #1a1a1a;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .footer-col a:hover {
    color: #ff7e33;
    text-decoration: none;
  }

  .footer-bottom {
    border-top: 1px solid #e5e5e5;
    padding: 1.25rem 1.5rem;
    text-align: center;
  }

  .footer-bottom p {
    max-width: 1200px;
    margin: 0 auto;
    font-size: 0.85rem;
    color: #666666;
  }

  @media (max-width: 700px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 2.5rem 1.25rem 1.5rem;
    }
    .footer-cols {
      gap: 1.5rem;
    }
  }
</style>
